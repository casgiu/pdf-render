// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Une génération de catalogue PDF, lancée en tâche de fond (fire-and-forget)
// pour ne pas bloquer la requête HTTP le temps que ça prenne — un catalogue
// complet avec des centaines de produits peut prendre plusieurs minutes.
model CatalogueJob {
  id           String    @id @default(cuid())
  shop         String
  type         String // "collection" | "full"
  label        String // nom affiché (titre de collection, ou "Catalogue complet")
  collectionId String? // gid Shopify de la collection, uniquement pour type="collection"
  status       String    @default("pending") // pending | running | done | error
  fileName    String?
  filePath    String?
  errorMessage String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  // Flipbook (livre à feuilleter) généré à partir du PDF de ce job, servi
  // via une page publique non authentifiée (lien à partager avec des clients).
  flipbookStatus String? // null | pending | running | done | error
  flipbookToken  String? @unique
  flipbookPath   String?
  flipbookError  String?

  @@index([shop, createdAt])
}

// Réglages visuels du catalogue PDF (couleurs, police, accroche), personnalisables
// depuis l'app plutôt que codés en dur dans pdf.server.js. Une ligne par boutique.
model CatalogueTheme {
  id              String   @id @default(cuid())
  shop            String   @unique
  backgroundColor String   @default("#F5F1EA")
  textColor       String   @default("#3B2E24")
  accentColor     String   @default("#B08D57")
  mutedColor      String   @default("#8A7B6C")
  lineColor       String   @default("#D8CFC0")
  fontFamily      String   @default("helvetica") // clé dans FONT_FAMILIES (pdf.server.js)
  tagline         String   @default("Mobilier & décoration haut de gamme")
  brandName       String?
  logoUrl         String?
  mainMenuHandle  String?
  updatedAt       DateTime @updatedAt
}
