// Schéma de lecture uniquement, conservé le temps de copier les données de
// l'ancienne base SQLite Render vers PostgreSQL. Ne pas l'utiliser dans l'app.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/legacy-sqlite"
}

datasource db {
  provider = "sqlite"
  url      = env("LEGACY_SQLITE_DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model CatalogueJob {
  id             String    @id
  shop           String
  type           String
  label          String
  collectionId   String?
  status         String    @default("pending")
  fileName       String?
  fileKey        String?
  filePath       String?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
  flipbookStatus String?
  flipbookToken  String?   @unique
  flipbookKey    String?
  flipbookPath   String?
  flipbookError  String?

  @@index([shop, createdAt])
}

model CatalogueTheme {
  id              String   @id
  shop            String   @unique
  backgroundColor String   @default("#F5F1EA")
  textColor       String   @default("#3B2E24")
  accentColor     String   @default("#B08D57")
  mutedColor      String   @default("#8A7B6C")
  lineColor       String   @default("#D8CFC0")
  fontFamily      String   @default("helvetica")
  tagline         String   @default("Mobilier & décoration haut de gamme")
  brandName       String?
  logoUrl         String?
  mainMenuHandle  String?
  updatedAt       DateTime @updatedAt
}
